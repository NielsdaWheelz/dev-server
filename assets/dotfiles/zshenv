# Managed by dev-server bootstrap.

# Remote commands, including Mosh's SSH bootstrap, do not read .zprofile or
# .zshrc. Keep the minimal executable search path available in every zsh.
for _devbox_path_dir in \
  /opt/homebrew/bin \
  /usr/local/bin \
  "$HOME/.local/share/mise/shims" \
  "$HOME/.local/bin" \
  "$HOME/.local/share/dev-server/ai-tools/node_modules/.bin" \
  "$HOME/bin"; do
  if [[ -d "$_devbox_path_dir" ]]; then
    case ":$PATH:" in
      *":$_devbox_path_dir:"*) ;;
      *) export PATH="$_devbox_path_dir:$PATH" ;;
    esac
  fi
done
unset _devbox_path_dir
