# Managed by dev-server.

# Remote commands, including Mosh's SSH bootstrap, do not read .zprofile or
# .zshrc. Shared Codex launchers must precede the raw npm binary even when an
# inherited PATH already contains both directories in the opposite order.
typeset -U path
for _dev_server_path_dir in \
  /usr/local/bin \
  /opt/homebrew/bin \
  "$HOME/.local/share/mise/shims" \
  "$HOME/.local/bin" \
  "$HOME/bin"; do
  if [[ -d "$_dev_server_path_dir" ]]; then
    path=("$_dev_server_path_dir" $path)
  fi
done
export PATH
unset _dev_server_path_dir
