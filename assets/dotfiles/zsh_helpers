# Managed Zsh interactive helpers for the dev box.

if command -v eza >/dev/null 2>&1; then
  alias ls='eza'
  alias ll='eza -lah --git --group-directories-first'
  alias tree='eza --tree'
else
  alias ll='ls -lah'
fi

if command -v bat >/dev/null 2>&1; then
  alias catp='bat'
fi

if command -v lazygit >/dev/null 2>&1; then
  alias lg='lazygit'
fi

if command -v yazi >/dev/null 2>&1; then
  alias y='yazi'
fi

alias gs='git status --short --branch'
alias t='tmux new -A -s main'
alias work='cd ~/src/work'
alias personal='cd ~/src/personal'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'

# default agent permissions for interactive shells; `command` bypasses aliases.
alias claude='claude --dangerously-skip-permissions'
alias claude-personal='claude-personal --dangerously-skip-permissions'
alias claude-work='claude-work --dangerously-skip-permissions'
alias codex='codex --yolo'
alias codex-personal='codex-personal --yolo'
alias codex-work='codex-work --yolo'
alias codex-work2='codex-work2 --yolo'
