#!/usr/bin/env bash
set -euo pipefail

case "${0##*/}" in
codex-work)
  state_dir="$HOME/.codex-work"
  export CODEX_HOME="$state_dir"
  tool=codex
  configure_notify=1
  ;;
codex-work2)
  state_dir="$HOME/.codex-work2"
  export CODEX_HOME="$state_dir"
  tool=codex
  configure_notify=1
  ;;
claude-work)
  state_dir="$HOME/.claude-work"
  export CLAUDE_CONFIG_DIR="$state_dir"
  tool=claude
  configure_notify=0
  ;;
*)
  printf 'error: unsupported AI profile command: %s\n' "${0##*/}" >&2
  exit 64
  ;;
esac

[[ -d "$state_dir" && ! -L "$state_dir" ]] || {
  printf 'error: AI profile state directory is unavailable: %s\n' \
    "$state_dir" >&2
  exit 1
}

real_binary="$HOME/.local/share/dev-server/ai-tools/node_modules/.bin/$tool"
[[ -x "$real_binary" ]] || {
  printf 'error: AI command is unavailable: %s\n' "$real_binary" >&2
  exit 1
}
if ((configure_notify)); then
  notify="$HOME/.local/bin/skid-notify"
  case "$notify" in
  *[\"\\]*)
    printf 'error: Codex notifier path cannot be encoded safely: %s\n' "$notify" >&2
    exit 1
    ;;
  esac
  exec "$real_binary" -c "notify=[\"$notify\"]" "$@"
fi
exec "$real_binary" "$@"
