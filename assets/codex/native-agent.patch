diff --git a/codex-rs/app-server/src/tui_view.rs b/codex-rs/app-server/src/tui_view.rs
new file mode 100644
index 0000000..546dfda
--- /dev/null
+++ b/codex-rs/app-server/src/tui_view.rs
@@ -0,0 +1,137 @@
+//! Local TUI selections and guarded control admission share this short critical section.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+use codex_app_server_protocol::ExpectedTuiView;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::TuiProcess;
+use codex_app_server_protocol::TuiView;
+
+use crate::connection_rpc_gate::ConnectionRpcGate;
+use crate::error_code::internal_error;
+use crate::error_code::invalid_params;
+use crate::transport::ConnectionId;
+
+#[derive(Default)]
+pub(crate) struct TuiViews(Mutex<Registry>);
+
+#[derive(Default)]
+struct Registry {
+    selections: HashMap<TuiProcess, Selection>,
+    registered: HashMap<ConnectionId, TuiProcess>,
+}
+
+struct Selection {
+    owner: ConnectionId,
+    view: TuiView,
+}
+
+impl TuiViews {
+    pub(crate) async fn update(
+        &self,
+        owner: ConnectionId,
+        gate: &ConnectionRpcGate,
+        peer_pid: Option<u32>,
+        process: TuiProcess,
+        thread_id: Option<String>,
+    ) -> Result<TuiView, JSONRPCErrorError> {
+        if peer_pid != Some(process.pid.get()) {
+            return Err(invalid_params(
+                "TUI selection requires its direct local Unix owner",
+            ));
+        }
+        let identity = codex_app_server_daemon::process_start_identity(process.pid.get())
+            .await
+            .map_err(|_| invalid_params("TUI process identity unavailable"))?;
+        if identity != process.start_identity {
+            return Err(invalid_params("TUI process identity changed"));
+        }
+        let mut registry = self
+            .0
+            .lock()
+            .map_err(|_| internal_error("TUI view registry unavailable"))?;
+        if gate.is_closed() {
+            return Err(invalid_params("TUI connection closed"));
+        }
+        if registry.registered.contains_key(&owner) {
+            let selection = registry
+                .selections
+                .get_mut(&process)
+                .filter(|selection| selection.owner == owner)
+                .ok_or_else(|| invalid_params("TUI connection selection revoked"))?;
+            selection.view.revision = selection
+                .view
+                .revision
+                .checked_add(1)
+                .ok_or_else(|| invalid_params("TUI view revision exhausted"))?;
+            selection.view.thread_id = thread_id;
+            return Ok(selection.view.clone());
+        }
+        if thread_id.is_some() {
+            return Err(invalid_params(
+                "TUI connection must register null selection",
+            ));
+        }
+        // Acknowledged reconnect-null revokes the previous owner, even while its socket is open.
+        let view = TuiView {
+            view_id: uuid::Uuid::now_v7().to_string(),
+            revision: 1,
+            thread_id,
+        };
+        registry.registered.insert(owner, process.clone());
+        registry.selections.insert(
+            process,
+            Selection {
+                owner,
+                view: view.clone(),
+            },
+        );
+        Ok(view)
+    }
+
+    pub(crate) fn read(&self, process: &TuiProcess) -> Result<Option<TuiView>, JSONRPCErrorError> {
+        let registry = self
+            .0
+            .lock()
+            .map_err(|_| internal_error("TUI view registry unavailable"))?;
+        Ok(registry
+            .selections
+            .get(process)
+            .map(|selection| selection.view.clone()))
+    }
+
+    pub(crate) fn admit(
+        &self,
+        expected: &ExpectedTuiView,
+        thread_id: &str,
+    ) -> Result<(), JSONRPCErrorError> {
+        let registry = self
+            .0
+            .lock()
+            .map_err(|_| internal_error("TUI view registry unavailable"))?;
+        if registry.selections.values().any(|selection| {
+            selection.view.view_id == expected.view_id
+                && selection.view.revision == expected.revision
+                && selection.view.thread_id.as_deref() == Some(thread_id)
+        }) {
+            Ok(())
+        } else {
+            Err(invalid_params("TUI selection changed"))
+        }
+    }
+
+    pub(crate) fn disconnect(&self, owner: ConnectionId) {
+        let Ok(mut registry) = self.0.lock() else {
+            return;
+        };
+        if let Some(process) = registry.registered.remove(&owner)
+            && registry
+                .selections
+                .get(&process)
+                .is_some_and(|selection| selection.owner == owner)
+        {
+            registry.selections.remove(&process);
+        }
+    }
+}
