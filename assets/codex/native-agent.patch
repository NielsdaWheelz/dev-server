+    )?)?;
+    ensure!(
+        manifest["skidPinned"] == true,
+        "provider package is not pinned"
+    );
+    let daemon = Daemon::from_environment()?;
+    ensure!(
+        daemon
+            .settings_file
+            .parent()
+            .and_then(std::path::Path::parent)
+            == Some(codex_home),
+        "resolved Codex home changed before daemon startup"
+    );
+    let _operation_lock = daemon.acquire_operation_lock().await?;
+    let selected = daemon.current_installation()?;
+    ensure!(
+        !crate::managed_install::package_root(codex_home)
+            .join("auto-update-version")
+            .exists(),
+        "selected daemon follows upstream updates; explicit repair required"
+    );
+    if selected.managed_codex_bin.is_file() {
+        ensure!(
+            crate::managed_install::executable_identity(&selected.managed_codex_bin).await?
+                == crate::managed_install::executable_identity(&std::env::current_exe()?).await?,
+            "selected daemon package differs from this pinned provider; explicit repair required"
+        );
+    }
+    if crate::client::probe(&selected.socket_path).await.is_ok() {
+        ensure!(
+            selected.managed_codex_bin.is_file(),
+            "listener has no matching pinned daemon package"
+        );
+        crate::client::probe_tui_view(&selected.socket_path, codex_home).await?;
+    }
+    let mut overrides = selected.load_settings().await?.feature_overrides;
+    overrides.extend(features.clone());
+    let output = Box::pin(selected.start(&overrides)).await?;
+    crate::client::probe_tui_view(&output.socket_path, codex_home).await?;
+    Ok(output)
+}
