+/// Kernel lifetime encoding shared with local TUI selection registration.
+pub async fn process_start_identity(pid: u32) -> Result<String> {
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    {
+        let (zombie, identity) = read_process_details(pid).await?;
+        anyhow::ensure!(!zombie, "process has exited");
+        let identity = match identity {
+            ProcessIdentity::Linux { start_ticks, .. } => start_ticks,
+            ProcessIdentity::MacOs {
+                start_seconds,
+                start_microseconds,
+            }
+            | ProcessIdentity::MacOsUnique {
+                start_seconds,
+                start_microseconds,
+                ..
+            } => start_seconds
+                .checked_mul(1_000_000)
+                .and_then(|seconds| seconds.checked_add(start_microseconds))
+                .context("process start identity overflow")?,
+        };
+        Ok(identity.to_string())
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    {
+        let _ = pid;
+        anyhow::bail!("local TUI process identity is unsupported")
+    }
+}
