+/// A read-only capability check; never registers or revokes a TUI selection.
+pub(crate) async fn probe_tui_view(socket_path: &Path, codex_home: &Path) -> Result<()> {
+    timeout(CONTROL_SOCKET_RESPONSE_TIMEOUT, async {
+        let mut websocket = connect(socket_path).await?;
+        let initialized = initialize(&mut websocket, /*experimental_api*/ true).await?;
+        anyhow::ensure!(
+            initialized.codex_home.as_path() == codex_home,
+            "listener belongs to a different Codex home"
+        );
+        send_message(
+            &mut websocket,
+            &JSONRPCMessage::Notification(JSONRPCNotification {
+                method: "initialized".to_string(),
+                params: None,
+            }),
+        )
+        .await?;
+        let id = RequestId::Integer(2);
+        send_message(
+            &mut websocket,
+            &JSONRPCMessage::Request(JSONRPCRequest {
+                id: id.clone(),
+                method: "tui/view/read".to_string(),
+                params: Some(serde_json::to_value(
+                    codex_app_server_protocol::TuiViewReadParams {
+                        process: codex_app_server_protocol::TuiProcess {
+                            pid: std::num::NonZeroU32::new(std::process::id())
+                                .context("invalid process id")?,
+                            start_identity: crate::process_start_identity(std::process::id())
+                                .await?,
+                        },
+                    },
+                )?),
+                trace: None,
+            }),
+        )
+        .await?;
+        loop {
+            match read_message(&mut websocket).await? {
+                JSONRPCMessage::Response(response) if response.id == id => {
+                    serde_json::from_value::<codex_app_server_protocol::TuiViewReadResponse>(
+                        response.result,
+                    )?;
+                    websocket.close(None).await.ok();
+                    return Ok(());
+                }
+                JSONRPCMessage::Error(error) if error.id == id => {
+                    return Err(anyhow!("listener lacks compatible native TUI observation"));
+                }
+                _ => {}
+            }
+        }
+    })
+    .await
+    .context("timed out checking native TUI listener")?
+}
