#!/usr/bin/env bash
set -euo pipefail

base_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=lib/common.sh
source "$base_dir/lib/common.sh"
# shellcheck source=lib/doctor.sh
source "$base_dir/lib/doctor.sh"
# shellcheck source=lib/skidbladnir.sh
source "$base_dir/lib/skidbladnir.sh"
# shellcheck source=lib/skidbladnir-invite.sh
source "$base_dir/lib/skidbladnir-invite.sh"
# shellcheck source=lib/skidbladnir-operator.sh
source "$base_dir/lib/skidbladnir-operator.sh"

skidbladnir_operator_require_macbook

usage() {
  cat <<'EOF'
Usage: ./skidbladnir <command>

Commands:
  doctor                 Check all three fixed gateways; change nothing.
  invite                 Display one five-minute, single-use fleet QR.
  reconcile-lifetime-digests
                         Reconcile inventory and print three tmux lifetime hashes.
  accept-host <host> --allow-host-convergence --allow-inventory-reconciliation
                         Converge one exact host twice and prove preservation.
  prepare-reboot <host> --allow-reboot-acceptance
                         Record a digest-only checkpoint before a reboot.
  verify-reboot <host> --allow-reboot-acceptance
                         Prove persistence after the host has rebooted.
  outage <host>          Stop one gateway for a bounded outage proof.
  recover <host>         Start one gateway after the outage proof.

Hosts: Local | DevServer | Arch

invite requires secrets/skidbladnir-origins.json as a user-owned mode-0600 file.
EOF
}

case "${1:-}" in
doctor)
  [[ $# -eq 1 ]] || die "Usage: ./skidbladnir doctor"
  skidbladnir_operator_doctor
  ;;
invite)
  [[ $# -eq 1 ]] || die "Usage: ./skidbladnir invite"
  skidbladnir_operator_invite "$base_dir/secrets/skidbladnir-origins.json" \
    "$(dev_server_home)/.local/bin/skidbladnir"
  ;;
reconcile-lifetime-digests)
  [[ $# -eq 1 ]] || die "Usage: ./skidbladnir reconcile-lifetime-digests"
  skidbladnir_operator_reconciled_lifetime_digests
  ;;
accept-host)
  if [[ $# -ne 4 ]]; then
    printf 'NOT_RUN  skidbladnir.accept-host        exact convergence and inventory-reconciliation authorization is required; no host was touched\n' >&2
    die "Usage: ./skidbladnir accept-host <Local|DevServer|Arch> --allow-host-convergence --allow-inventory-reconciliation"
  fi
  skidbladnir_operator_accept_host "$2" "$3" "$4"
  ;;
prepare-reboot | verify-reboot)
  if [[ $# -ne 3 ]]; then
    printf 'NOT_RUN  skidbladnir.accept-host.reboot exact reboot acceptance authorization is required; no checkpoint was changed\n' >&2
    die "Usage: ./skidbladnir <prepare-reboot|verify-reboot> <Local|DevServer|Arch> --allow-reboot-acceptance"
  fi
  skidbladnir_operator_reboot_acceptance "${1%-reboot}" "$2" "$3"
  ;;
outage | recover)
  [[ $# -eq 2 ]] || die "Usage: ./skidbladnir $1 <Local|DevServer|Arch>"
  skidbladnir_operator_service "$1" "$2"
  ;;
-h | --help | help | "")
  usage
  ;;
*)
  usage >&2
  exit 1
  ;;
esac
