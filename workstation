#!/usr/bin/env bash
set -euo pipefail

base_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=lib/common.sh
source "$base_dir/lib/common.sh"
# shellcheck source=lib/tmux.sh
source "$base_dir/lib/tmux.sh"
# shellcheck source=lib/dotfiles.sh
source "$base_dir/lib/dotfiles.sh"
# shellcheck source=lib/personal-arch.sh
source "$base_dir/lib/personal-arch.sh"
# shellcheck source=lib/personal-macos.sh
source "$base_dir/lib/personal-macos.sh"
# shellcheck source=lib/ai-tools.sh
source "$base_dir/lib/ai-tools.sh"
# shellcheck source=lib/memory.sh
source "$base_dir/lib/memory.sh"
# shellcheck source=lib/skidbladnir.sh
source "$base_dir/lib/skidbladnir.sh"
# shellcheck source=lib/activation.sh
source "$base_dir/lib/activation.sh"

workstation_platform=''
workstation_target=''
workstation_declared_stage=''

usage() {
  printf '%s\n' \
    'Usage: ./workstation apply' \
    '       ./workstation help' \
    '' \
    'apply updates rolling software and reconciles configuration and exact repository pins.' \
    'codex daemon updates may interrupt active work; claude is adopted without update.'
}

workstation_select_target() {
  case "$(uname -s)" in
  Darwin)
    workstation_platform=macos
    workstation_target=macbook
    # shellcheck source=lib/packages-macos.sh
    source "$base_dir/lib/packages-macos.sh"
    ;;
  Linux)
    personal_arch_owned_host ||
      die 'workstation apply supports only the owned arch host'
    workstation_platform=arch
    workstation_target=arch
    # shellcheck source=lib/packages-arch.sh
    source "$base_dir/lib/packages-arch.sh"
    ;;
  *) die "unsupported workstation platform: $(uname -s)" ;;
  esac
}

workstation_report_deferrals() {
  if [[ "$workstation_platform" == macos ]]; then
    if ((personal_macos_desktop_deferred)); then
      render_result DEFERRED Ghostty \
        "reload config with cmd+shift+, or reopen Ghostty"
    fi
  else
    if ((personal_arch_desktop_deferred)); then
      render_result DEFERRED "desktop session" \
        "log out and back in to activate session changes"
    fi
    if ((personal_arch_reboot_deferred)); then
      render_result DEFERRED reboot \
        "reboot to activate kernel or boot-time changes"
    fi
  fi
}

workstation_snapshot() {
  (($# == 1)) || die 'workstation_snapshot needs one declared-input root'
  local root="$1"
  local -a memory_inputs=()
  if [[ -d "$root/secrets/memory/bundle/$workstation_target" ]]; then
    memory_inputs=("secrets/memory/bundle/$workstation_target")
  fi

  case "$workstation_platform" in
  macos)
    dev_server_declared_snapshot "$root" lib assets packages/Brewfile "${memory_inputs[@]}"
    ;;
  arch)
    dev_server_declared_snapshot "$root" \
      lib assets packages/arch.pacman.txt packages/arch.aur.txt "${memory_inputs[@]}"
    ;;
  *) return 1 ;;
  esac
}

workstation_cleanup_on_exit() {
  local rc=$?
  trap - EXIT HUP INT TERM
  [[ -n "$workstation_target" ]] || workstation_target=workstation
  if [[ -n "$workstation_declared_stage" ]]; then
    case "$workstation_declared_stage" in
    "${TMPDIR:-/tmp}"/workstation-declared.??????)
      if [[ -d "$workstation_declared_stage" && ! -L "$workstation_declared_stage" ]]; then
        chmod -R u+rwX "$workstation_declared_stage" 2>/dev/null || rc=1
        rm -R -- "$workstation_declared_stage" || rc=1
      elif [[ -e "$workstation_declared_stage" || -L "$workstation_declared_stage" ]]; then
        rc=1
      fi
      ;;
    *) rc=1 ;;
    esac
  fi
  if ((rc != 0 && rc != 2 && dev_server_result_errors == 0)); then
    render_result ERROR "$workstation_target" 'apply or cleanup failed; earlier changes may remain'
  elif ((rc == 2 && dev_server_result_actions == 0 && dev_server_result_deferrals == 0)); then
    render_result ACTION "$workstation_target" 'completion requires attention'
  fi
  if finish_results "$workstation_target"; then rc=0; else rc=$?; fi
  exit "$rc"
}

workstation_stage_declared_inputs() {
  local desired_snapshot staged_snapshot

  desired_snapshot="$(workstation_snapshot "$base_dir")" ||
    die 'could not resolve workstation desired inputs'
  workstation_declared_stage="$(
    mktemp -d "${TMPDIR:-/tmp}/workstation-declared.XXXXXX"
  )" || die 'could not stage workstation desired inputs'
  chmod 0700 "$workstation_declared_stage" ||
    die 'could not secure workstation desired inputs'
  install -d -m 0700 "$workstation_declared_stage/packages" ||
    die 'could not stage workstation package inputs'
  cp -Rp "$base_dir/assets" "$workstation_declared_stage/assets" ||
    die 'could not stage workstation assets'
  cp -Rp "$base_dir/lib" "$workstation_declared_stage/lib" ||
    die 'could not stage workstation libraries'
  if [[ -d "$base_dir/secrets/memory/bundle/$workstation_target" ]]; then
    install -d -m 0700 "$workstation_declared_stage/secrets/memory/bundle" ||
      die 'could not stage private memory configuration'
    cp -Rp "$base_dir/secrets/memory/bundle/$workstation_target" \
      "$workstation_declared_stage/secrets/memory/bundle/" ||
      die 'could not stage private memory inputs'
  fi
  case "$workstation_platform" in
  macos)
    cp -p "$base_dir/packages/Brewfile" \
      "$workstation_declared_stage/packages/Brewfile" ||
      die 'could not stage workstation package manifest'
    ;;
  arch)
    cp -p \
      "$base_dir/packages/arch.pacman.txt" \
      "$base_dir/packages/arch.aur.txt" \
      "$workstation_declared_stage/packages/" ||
      die 'could not stage workstation package manifests'
    ;;
  *) die "unsupported workstation platform: $workstation_platform" ;;
  esac
  staged_snapshot="$(workstation_snapshot "$workstation_declared_stage")" ||
    die 'could not verify staged workstation desired inputs'
  [[ "$staged_snapshot" == "$desired_snapshot" ]] ||
    die 'workstation inputs changed while staging; rerun'

  # Execute the same libraries whose staged bytes were checked above.
  # shellcheck source=lib/common.sh
  source "$workstation_declared_stage/lib/common.sh"
  # shellcheck source=lib/tmux.sh
  source "$workstation_declared_stage/lib/tmux.sh"
  # shellcheck source=lib/dotfiles.sh
  source "$workstation_declared_stage/lib/dotfiles.sh"
  # shellcheck source=lib/personal-arch.sh
  source "$workstation_declared_stage/lib/personal-arch.sh"
  # shellcheck source=lib/personal-macos.sh
  source "$workstation_declared_stage/lib/personal-macos.sh"
  # shellcheck source=lib/ai-tools.sh
  source "$workstation_declared_stage/lib/ai-tools.sh"
  # shellcheck source=lib/memory.sh
  source "$workstation_declared_stage/lib/memory.sh"
  # shellcheck source=lib/skidbladnir.sh
  source "$workstation_declared_stage/lib/skidbladnir.sh"
  # shellcheck source=lib/activation.sh
  source "$workstation_declared_stage/lib/activation.sh"
  case "$workstation_platform" in
  macos)
    # shellcheck source=lib/packages-macos.sh
    source "$workstation_declared_stage/lib/packages-macos.sh"
    ;;
  arch)
    # shellcheck source=lib/packages-arch.sh
    source "$workstation_declared_stage/lib/packages-arch.sh"
    ;;
  esac
  # shellcheck disable=SC2034 # read by platform package libraries.
  dev_server_root="$workstation_declared_stage"
  dev_server_assets_root="$workstation_declared_stage/assets"
}

workstation_prepare_arch_sudo() {
  # keep credentials out of shell tracing and never execute the env file.
  set +x
  local line
  if [[ -z "${ARCH_PASS:-}" && -f "$base_dir/.env" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      [[ "$line" == ARCH_PASS=* ]] || continue
      ARCH_PASS="${line#ARCH_PASS=}"
      case "$ARCH_PASS" in
      \"*\" | \'*\') ARCH_PASS="${ARCH_PASS:1:${#ARCH_PASS}-2}" ;;
      esac
      break
    done <"$base_dir/.env"
  fi
  [[ -n "${ARCH_PASS:-}" ]] || die 'set ARCH_PASS in the environment or the repo .env for arch apply'
  export ARCH_PASS
  SUDO_ASKPASS="$(dev_server_assets_dir)/routers/arch-sudo-askpass"
  export SUDO_ASKPASS
  [[ -x "$SUDO_ASKPASS" ]] || die 'arch sudo askpass helper is unavailable'
  require_cmd sudo
  # applies to all sourced host libraries; yay gets the same flag explicitly.
  sudo() { command sudo --askpass "$@"; }
  sudo --reset-timestamp --validate </dev/null || die 'arch sudo authentication failed'
}

workstation_preflight() {
  workstation_select_target
  workstation_stage_declared_inputs
  if [[ "$workstation_platform" == arch ]]; then
    workstation_prepare_arch_sudo
    exec </dev/null
  fi
}

workstation_apply() {
  local memory_status status ai_status=0 before_pending
  trap workstation_cleanup_on_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  workstation_preflight
  if activation_check "$workstation_platform"; then :; else return $?; fi
  packages_install
  if [[ "$workstation_platform" == macos ]]; then
    tmux_verify_stable_version /opt/homebrew/bin/tmux
  else
    tmux_verify_stable_version /usr/bin/tmux
  fi
  dotfiles_install
  if [[ "$workstation_platform" == arch ]]; then
    personal_arch_apply
  else
    personal_macos_apply
  fi
  before_pending=$((dev_server_result_actions + dev_server_result_deferrals))
  # shellcheck disable=SC2119 # this helper deliberately accepts no arguments.
  if ai_install; then :; else
    ai_status=$?
    ((ai_status == 2)) || return "$ai_status"
    if ((dev_server_result_actions + dev_server_result_deferrals == before_pending)); then
      render_result ACTION 'AI tools' 'installation requires attention'
    fi
  fi
  if memory_install "$workstation_platform" \
    "$workstation_declared_stage/secrets/memory/bundle/$workstation_target"; then :; else
    memory_status=$?
    ((memory_status == 2)) || die 'could not install universal memory host configuration'
  fi
  if skidbladnir_apply "$workstation_platform"; then :; else
    status=$?
    ((status == 2)) || return "$status"
  fi
  if ((ai_status == 0)); then
    before_pending=$((dev_server_result_actions + dev_server_result_deferrals))
    if activation_apply "$workstation_platform" "$workstation_target"; then :; else
      status=$?
      ((status == 2)) || return "$status"
      if ((dev_server_result_actions + dev_server_result_deferrals == before_pending)); then
        render_result ACTION activation 'completion requires attention; inspect the activation result before retrying'
      fi
    fi
  fi
  workstation_report_deferrals
}

main() {
  local operation

  if (($# == 0)); then
    usage >&2
    return 64
  fi
  operation="$1"
  shift

  case "$operation" in
  apply)
    (($# == 0)) || {
      usage >&2
      return 64
    }
    workstation_apply
    ;;
  help | --help | -h)
    (($# == 0)) || {
      usage >&2
      return 64
    }
    usage
    ;;
  *)
    usage >&2
    return 64
    ;;
  esac
}

main "$@"
