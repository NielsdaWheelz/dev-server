#!/usr/bin/env bash
set -euo pipefail

base_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# shellcheck source=lib/common.sh
source "$base_dir/lib/common.sh"
# shellcheck source=lib/remote-devbox.sh
source "$base_dir/lib/remote-devbox.sh"
# shellcheck source=lib/dotfiles.sh
source "$base_dir/lib/dotfiles.sh"
# shellcheck source=lib/ai-tools.sh
source "$base_dir/lib/ai-tools.sh"
# shellcheck source=lib/skidbladnir.sh
source "$base_dir/lib/skidbladnir.sh"

server_name='dev-server'
server_type='cpx31'
server_image='ubuntu-24.04'
server_image_architecture='x86'
server_location='hil'
hcloud_context='dev-infra'
firewall_name='dev-server-private'
server_user='niels'
deploy_user='dev-server-deploy'
operator_identity="$HOME/.ssh/id_ed25519"
deploy_identity="$HOME/.ssh/dev-server-deploy"
ssh_include_dir="$HOME/.ssh/config.d"
ssh_include="$ssh_include_dir/$server_name"
ssh_known_hosts="$HOME/.ssh/known_hosts"
ssh_known_hosts_file="$ssh_known_hosts"
tailscale_auth_key_file="$base_dir/secrets/tailscale-auth-key"
template="$base_dir/cloud-init-devbox.template.yaml"
ansible_inventory="$base_dir/ansible/inventory/devbox.yml"
ansible_apply_playbook="$base_dir/ansible/playbooks/apply.yml"
ansible_config="$base_dir/ansible.cfg"

server_id=''
server_public_ip=''
server_status=''
firewall_id=''
tailnet_host=''
rendered_cloud_init=''
ssh_include_candidate=''
ssh_known_hosts_candidate=''
ssh_known_hosts_candidate_old=''
ansible_output=''
steady_rules=''
bootstrap_rules=''
bootstrap_cidr=''
bootstrap_cleanup_required=0
new_host_key_established=0
host_key_enrollment=0
devbox_desired_snapshot=''
devbox_declared_stage=''

usage() {
  cat <<'EOF'
Usage: ./devbox apply
       ./devbox help

Create the devbox when absent, or apply its declared state over tailnet SSH.

An existing host must already have the dev-server-deploy principal, its
deployment key, and a verified host key. The hard-cutover runbook establishes
those once; apply has no privileged-user or public-SSH fallback.
EOF
}

hcloud_cmd() {
  hcloud --context "$hcloud_context" "$@"
}

private_key_public() {
  local identity="$1"
  local mode public_key

  [[ -f "$identity" && ! -L "$identity" ]] || return 1
  mode="$(file_mode "$identity")" || return 1
  [[ "$mode" == 400 || "$mode" == 600 ]] || return 1
  public_key="$(ssh-keygen -y -f "$identity" 2>/dev/null)" || return 1
  [[ "$public_key" =~ ^ssh-(ed25519|rsa)[[:space:]][A-Za-z0-9+/=]+$ ]] ||
    return 1
  printf '%s\n' "$public_key"
}

observe_server() {
  local observation servers rc

  servers="$(hcloud_cmd server list -o json)" || return 1
  set +e
  observation="$(HCLOUD_SERVERS="$servers" python3 -c '
import json, os, sys

servers = [item for item in json.loads(os.environ["HCLOUD_SERVERS"])
           if item.get("name") == sys.argv[1]]
if len(servers) > 1:
    raise SystemExit("duplicate devbox server names")
if not servers:
    raise SystemExit(3)
server = servers[0]
address = ((server.get("public_net") or {}).get("ipv4") or {}).get("ip", "")
print("{}\t{}\t{}".format(server.get("id", ""), address,
                           server.get("status", "")))
' "$server_name")"
  rc=$?
  set -e
  if ((rc == 3)); then
    server_id=''
    server_public_ip=''
    server_status=''
    return 0
  fi
  ((rc == 0)) || return 1

  IFS=$'\t' read -r server_id server_public_ip server_status <<<"$observation"
  [[ "$server_id" =~ ^[0-9]+$ && -n "$server_public_ip" ]] || return 1
}

observe_firewall() {
  local firewalls observation rc

  firewalls="$(hcloud_cmd firewall list -o json)" || return 1
  set +e
  observation="$(HCLOUD_FIREWALLS="$firewalls" python3 -c '
import json, os, sys

items = [item for item in json.loads(os.environ["HCLOUD_FIREWALLS"])
         if item.get("name") == sys.argv[1]]
if len(items) > 1:
    raise SystemExit("duplicate devbox firewall names")
if not items:
    raise SystemExit(3)
print(items[0].get("id", ""))
' "$firewall_name")"
  rc=$?
  set -e
  if ((rc == 3)); then
    firewall_id=''
    return 0
  fi
  ((rc == 0)) || return 1
  [[ "$observation" =~ ^[0-9]+$ ]] || return 1
  firewall_id="$observation"
}

tailnet_peer() {
  local status_json="$1"

  TAILSCALE_STATUS="$status_json" python3 -c '
import json, os, re, sys

status = json.loads(os.environ["TAILSCALE_STATUS"])
if status.get("BackendState") != "Running":
    raise SystemExit("local Tailscale is not running")
peers = list((status.get("Peer") or {}).values())
matches = []
for peer in peers:
    dns_name = str(peer.get("DNSName") or "").rstrip(".")
    host_name = str(peer.get("HostName") or "")
    if host_name == sys.argv[1] or dns_name.split(".", 1)[0] == sys.argv[1]:
        matches.append((dns_name, peer.get("Online")))
if len(matches) > 1:
    raise SystemExit("duplicate tailnet devbox nodes")
if not matches or not matches[0][0]:
    raise SystemExit(3)
if matches[0][1] is not True:
    raise SystemExit("tailnet devbox node is offline")
labels = matches[0][0].split(".")
if (len(matches[0][0]) > 253 or len(labels) < 2 or
    any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label)
        for label in labels)):
    raise SystemExit("tailnet devbox DNS name is invalid")
print(matches[0][0])
' "$server_name"
}

validate_ipv4() {
  python3 -c 'import ipaddress, sys; ipaddress.IPv4Address(sys.argv[1])' "$1"
}

steady_firewall_rules() {
  cat <<'JSON'
[
  {
    "description": "Tailscale direct WireGuard",
    "direction": "in",
    "protocol": "udp",
    "port": "41641",
    "source_ips": ["0.0.0.0/0", "::/0"]
  }
]
JSON
}

bootstrap_firewall_rules() {
  local cidr="$1"

  printf '%s\n' '['
  printf '%s\n' '  {'
  printf '%s\n' '    "description": "Tailscale direct WireGuard",'
  printf '%s\n' '    "direction": "in",'
  printf '%s\n' '    "protocol": "udp",'
  printf '%s\n' '    "port": "41641",'
  printf '%s\n' '    "source_ips": ["0.0.0.0/0", "::/0"]'
  printf '%s\n' '  },'
  printf '%s\n' '  {'
  printf '%s\n' '    "description": "Temporary devbox bootstrap SSH",'
  printf '%s\n' '    "direction": "in",'
  printf '%s\n' '    "protocol": "tcp",'
  printf '%s\n' '    "port": "22",'
  printf '    "source_ips": ["%s"]\n' "$cidr"
  printf '%s\n' '  }'
  printf '%s\n' ']'
}

firewall_rules_match() {
  local desired="$1"
  local observed

  observed="$(hcloud_cmd firewall describe "$firewall_name" -o json)" ||
    return 1
  DESIRED_FIREWALL_RULES="$desired" OBSERVED_FIREWALL="$observed" \
    python3 -c '
import json, os

def normalize(rule):
    return {
        "description": rule.get("description", ""),
        "direction": rule.get("direction", ""),
        "protocol": rule.get("protocol", ""),
        "port": str(rule.get("port") or ""),
        "source_ips": sorted(rule.get("source_ips") or []),
        "destination_ips": sorted(rule.get("destination_ips") or []),
    }

desired = json.loads(os.environ["DESIRED_FIREWALL_RULES"])
observed = json.loads(os.environ["OBSERVED_FIREWALL"]).get("rules") or []
raise SystemExit(0 if sorted(map(normalize, desired), key=str) ==
                 sorted(map(normalize, observed), key=str) else 1)
'
}

set_firewall_rules() {
  local desired="$1"
  local phase="$2"

  if firewall_rules_match "$desired"; then
    return 0
  fi
  printf '%s\n' "$desired" |
    hcloud_cmd firewall replace-rules --rules-file - "$firewall_name" ||
    return 1
  render_result CHANGED 'Hetzner firewall' "$phase rules"
}

firewall_applies_only_to() {
  local expected_server_id="$1"
  local allow_empty="${2:-false}"
  local observed

  observed="$(hcloud_cmd firewall describe "$firewall_name" -o json)" ||
    return 1
  OBSERVED_FIREWALL="$observed" python3 -c '
import json, os, sys

applied = json.loads(os.environ["OBSERVED_FIREWALL"]).get("applied_to") or []
ids = []
for item in applied:
    if item.get("type") != "server":
        raise SystemExit(1)
    ids.append(str((item.get("server") or {}).get("id", "")))
expected, allow_empty = sys.argv[1:]
desired = [expected] if expected else []
ok = ids == desired or (allow_empty == "true" and not ids)
raise SystemExit(0 if ok else 1)
' "$expected_server_id" "$allow_empty"
}

ssh_with_identity() {
  local user="$1"
  local identity="$2"
  local host="$3"
  local strict="$4"
  local remote_command
  local -a host_key_options=(-o IdentitiesOnly=yes)
  shift 4

  remote_command="$(quote_remote_args "$@")"
  if ((host_key_enrollment)); then
    host_key_options=(
      -o GlobalKnownHostsFile=/dev/null
      -o HashKnownHosts=no
      -o HostKeyAlgorithms=ssh-ed25519
      -o UpdateHostKeys=no
      -o IdentitiesOnly=yes
    )
  fi
  ssh -T \
    -o RequestTTY=no \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    -o "HostKeyAlias=$server_name" \
    -o "StrictHostKeyChecking=$strict" \
    -o UserKnownHostsFile="$ssh_known_hosts_file" \
    "${host_key_options[@]}" \
    -i "$identity" \
    "$user@$host" "$remote_command"
}

ssh_remote() {
  local host="$1"
  local strict="$2"
  shift 2

  ssh_with_identity "$deploy_user" "$deploy_identity" \
    "$host" "$strict" "$@"
}

ssh_operator_remote() {
  local host="$1"
  local strict="$2"
  shift 2

  ssh_with_identity "$server_user" "$operator_identity" \
    "$host" "$strict" "$@"
}

assert_remote_tailscale_ssh_disabled() {
  local host="$1"
  local prefs state

  prefs="$(ssh_remote "$host" yes \
    sudo -n -- timeout 10 tailscale debug prefs)" ||
    die 'could not inspect the remote Tailscale SSH preference'
  ((${#prefs} <= 65536)) ||
    die 'remote Tailscale preferences exceed the size boundary'
  state="$(TAILSCALE_PREFS="$prefs" python3 -c '
import json, os

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate Tailscale preference key")
        result[key] = value
    return result

prefs = json.loads(os.environ["TAILSCALE_PREFS"],
                   object_pairs_hook=unique_object)
if not isinstance(prefs, dict) or type(prefs.get("RunSSH")) is not bool:
    raise SystemExit("Tailscale preferences have no boolean RunSSH field")
print("enabled" if prefs["RunSSH"] else "disabled")
')" || die 'remote Tailscale preferences have an invalid schema'
  if [[ "$state" == enabled ]]; then
    render_result ACTION 'devbox SSH cutover' \
      'from the Hetzner console run: sudo tailscale set --ssh=false; verify the OpenSSH host key, then rerun ./devbox apply'
    finish_results devbox
  fi
}

wait_for_public_ssh() {
  local attempts=60

  while ((attempts > 0)); do
    if ssh_remote "$server_public_ip" accept-new true >/dev/null 2>&1; then
      new_host_key_established=1
      return 0
    fi
    sleep 5
    attempts=$((attempts - 1))
  done
  die "public bootstrap SSH did not become ready for $server_name"
}

wait_for_tailnet_host() {
  local attempts=60 status_json

  while ((attempts > 0)); do
    status_json="$(tailscale status --json)" || return 1
    if tailnet_host="$(tailnet_peer "$status_json" 2>/dev/null)"; then
      printf '%s\n' "$tailnet_host"
      return 0
    fi
    sleep 5
    attempts=$((attempts - 1))
  done
  return 1
}

close_host_bootstrap() {
  ((new_host_key_established == 1)) || return 0

  ssh_remote "$server_public_ip" yes \
    sudo -n -- bash -c \
    'set -euo pipefail; cidr="$1"; ufw --force delete allow from "$cidr" to any port 22 proto tcp >/dev/null 2>&1 || true; status="$(ufw status)"; ! grep -F "$cidr" <<<"$status" | grep -Eq "(^|[[:space:]])22(/tcp)?([[:space:]]|$)"' \
    _ "$bootstrap_cidr"
}

cleanup_bootstrap() {
  local failed=0

  close_host_bootstrap || {
    warn 'could not prove host bootstrap UFW rule removal'
    failed=1
  }
  set_firewall_rules "$steady_rules" steady || {
    warn 'could not restore the steady Hetzner firewall rules'
    failed=1
  }
  ((failed != 0)) || bootstrap_cleanup_required=0
  return "$failed"
}

cleanup_on_exit() {
  local rc=$?

  trap - EXIT HUP INT TERM
  if ((bootstrap_cleanup_required == 1)); then
    cleanup_bootstrap || rc=1
  fi
  [[ -z "$rendered_cloud_init" ]] || rm -f -- "$rendered_cloud_init"
  [[ -z "$ssh_include_candidate" ]] || rm -f -- "$ssh_include_candidate"
  [[ -z "$ssh_known_hosts_candidate" ]] || rm -f -- "$ssh_known_hosts_candidate"
  [[ -z "$ssh_known_hosts_candidate_old" ]] || rm -f -- "$ssh_known_hosts_candidate_old"
  [[ -z "$ansible_output" ]] || rm -f -- "$ansible_output"
  if [[ -n "$devbox_declared_stage" ]]; then
    case "$devbox_declared_stage" in
    "${TMPDIR:-/tmp}"/devbox-declared.??????)
      rm -R -- "$devbox_declared_stage" || rc=1
      ;;
    *) rc=1 ;;
    esac
  fi
  exit "$rc"
}

prepare_new_host_key_candidate() {
  ensure_directory "$HOME/.ssh" 0700 >/dev/null
  if [[ -e "$ssh_known_hosts" || -L "$ssh_known_hosts" ]]; then
    [[ -f "$ssh_known_hosts" && ! -L "$ssh_known_hosts" ]] ||
      die "known-hosts target is not a regular file: $ssh_known_hosts"
  fi
  ssh_known_hosts_candidate="$(mktemp "$HOME/.ssh/.known_hosts.dev-server.XXXXXX")" ||
    die 'could not stage the devbox known-hosts cutover'
  ssh_known_hosts_candidate_old="$ssh_known_hosts_candidate.old"
  if [[ -f "$ssh_known_hosts" ]]; then
    install -m 0600 "$ssh_known_hosts" "$ssh_known_hosts_candidate" ||
      die 'could not copy the existing known-hosts trust store'
  else
    chmod 0600 "$ssh_known_hosts_candidate" ||
      die 'could not secure the staged known-hosts trust store'
  fi
  ssh-keygen -R "$server_name" -f "$ssh_known_hosts_candidate" >/dev/null ||
    die 'could not remove the replaced devbox alias from staged known hosts'
  rm -f -- "$ssh_known_hosts_candidate_old"
  ssh-keygen -R "$server_public_ip" -f "$ssh_known_hosts_candidate" >/dev/null ||
    die 'could not remove the replaced devbox address from staged known hosts'
  rm -f -- "$ssh_known_hosts_candidate_old"
  python3 - "$ssh_known_hosts_candidate" <<'PY' ||
import os
import stat
import sys

status = os.lstat(sys.argv[1])
valid = (
    stat.S_ISREG(status.st_mode)
    and stat.S_IMODE(status.st_mode) == 0o600
    and status.st_size <= 1024 * 1024
)
raise SystemExit(0 if valid else 1)
PY
    die 'staged devbox known-hosts trust exceeds its safety boundary'
  ssh_known_hosts_file="$ssh_known_hosts_candidate"
  host_key_enrollment=1
}

validate_new_host_key_candidate() {
  python3 - "$ssh_known_hosts_candidate" "$server_name" <<'PY'
import base64
import binascii
import os
import stat
import struct
import subprocess
import sys

path, hostname = sys.argv[1:]
status = os.lstat(path)
if (
    not stat.S_ISREG(status.st_mode)
    or stat.S_IMODE(status.st_mode) != 0o600
    or status.st_size == 0
    or status.st_size > 1024 * 1024
):
    raise SystemExit(1)

try:
    lookup = subprocess.run(
        ["ssh-keygen", "-F", hostname, "-f", path],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=5,
    )
except (OSError, subprocess.SubprocessError):
    raise SystemExit(1)
if (
    lookup.returncode != 0
    or len(lookup.stdout) > 65536
    or len(lookup.stderr) > 65536
):
    raise SystemExit(1)

records = []
for line in lookup.stdout.splitlines():
    if not line or line.lstrip().startswith(b"#"):
        continue
    if len(line) > 16384:
        raise SystemExit(1)
    records.append(line.split())
if len(records) != 1 or len(records[0]) != 3:
    raise SystemExit(1)
host, algorithm, encoded = records[0]
if host != hostname.encode("ascii") or algorithm != b"ssh-ed25519":
    raise SystemExit(1)
try:
    blob = base64.b64decode(encoded, validate=True)
except (binascii.Error, ValueError):
    raise SystemExit(1)

def read_field(value, offset):
    if offset + 4 > len(value):
        raise ValueError
    length = struct.unpack(">I", value[offset:offset + 4])[0]
    offset += 4
    if length > len(value) - offset:
        raise ValueError
    return value[offset:offset + length], offset + length

try:
    embedded_algorithm, offset = read_field(blob, 0)
    key, offset = read_field(blob, offset)
except ValueError:
    raise SystemExit(1)
if embedded_algorithm != algorithm or len(key) != 32 or offset != len(blob):
    raise SystemExit(1)
PY
}

commit_new_host_key() {
  validate_new_host_key_candidate ||
    die 'staged devbox known-hosts trust is invalid'
  atomic_install_file "$ssh_known_hosts_candidate" "$ssh_known_hosts" 0600 ||
    die 'could not promote the verified devbox host key'
  rm -f -- "$ssh_known_hosts_candidate"
  ssh_known_hosts_candidate=''
  ssh_known_hosts_candidate_old=''
  ssh_known_hosts_file="$ssh_known_hosts"
  host_key_enrollment=0
}

install_ssh_config() {
  local status

  ensure_directory "$HOME/.ssh" 0700
  ensure_directory "$ssh_include_dir" 0700
  ssh_include_candidate="$(mktemp "$ssh_include_dir/.dev-server.candidate.XXXXXX")"

  {
    printf '# Managed by dev-server.\n'
    printf 'Host %s\n' "$server_name"
    printf '  HostName %s\n' "$tailnet_host"
    printf '  User %s\n' "$server_user"
    printf '  IdentityFile "%s"\n' "$operator_identity"
    printf '  IdentitiesOnly yes\n'
    printf '  HostKeyAlias %s\n' "$server_name"
    printf '  StrictHostKeyChecking yes\n'
    printf '  ForwardAgent no\n'
    printf '  ServerAliveInterval 30\n'
    printf '  ServerAliveCountMax 4\n'
    printf '\n'
    printf 'Host %s\n' "$deploy_user"
    printf '  HostName %s\n' "$tailnet_host"
    printf '  User %s\n' "$deploy_user"
    printf '  IdentityFile "%s"\n' "$deploy_identity"
    printf '  IdentitiesOnly yes\n'
    printf '  HostKeyAlias %s\n' "$server_name"
    printf '  StrictHostKeyChecking yes\n'
    printf '  ForwardAgent no\n'
    printf '  ServerAliveInterval 30\n'
    printf '  ServerAliveCountMax 4\n'
  } >"$ssh_include_candidate"
  chmod 0600 "$ssh_include_candidate"
  ssh -G -F "$ssh_include_candidate" "$server_name" >/dev/null ||
    die 'generated devbox SSH include is invalid'
  ssh -G -F "$ssh_include_candidate" "$deploy_user" >/dev/null ||
    die 'generated devbox deployment SSH include is invalid'

  atomic_install_file "$ssh_include_candidate" "$ssh_include" 0600
  # Published by the shared atomic-install contract.
  # shellcheck disable=SC2154
  status="$dev_server_install_status"
  [[ "$status" == 'UP TO DATE' ]] ||
    render_result "$status" 'SSH client config' "$ssh_include"
  rm -f -- "$ssh_include_candidate"
  ssh_include_candidate=''
}

render_cloud_init() {
  local operator_public_key="$1"
  local deploy_public_key="$2"
  local auth_key="$3"
  local auth_key_base64

  auth_key_base64="$(printf '%s' "$auth_key" | base64 | tr -d '\n')"
  rendered_cloud_init="$(mktemp "${TMPDIR:-/tmp}/devbox-cloud-init.XXXXXX")"
  awk \
    -v auth_key="$auth_key_base64" \
    -v bootstrap_cidr="$bootstrap_cidr" \
    -v deploy_public_key="$deploy_public_key" \
    -v deploy_user="$deploy_user" \
    -v operator_public_key="$operator_public_key" \
    -v server_name="$server_name" \
    -v server_user="$server_user" \
    '{
      gsub("__TAILSCALE_AUTH_KEY_B64__", auth_key)
      gsub("__BOOTSTRAP_SSH_CIDR__", bootstrap_cidr)
      gsub("__DEPLOY_PUBLIC_KEY__", deploy_public_key)
      gsub("__DEPLOY_USER__", deploy_user)
      gsub("__OPERATOR_PUBLIC_KEY__", operator_public_key)
      gsub("__SERVER_NAME__", server_name)
      gsub("__SERVER_USER__", server_user)
      print
    }' "$template" >"$rendered_cloud_init"
  chmod 0600 "$rendered_cloud_init"
  if grep -Eq '__[A-Z0-9_]+__' "$rendered_cloud_init"; then
    die 'rendered cloud-init contains an unresolved placeholder'
  fi
}

devbox_snapshot() {
  local root="$1"

  dev_server_declared_snapshot "$root" \
    ansible ansible.cfg assets cloud-init-devbox.template.yaml lib
}

devbox_stage_declared_inputs() {
  local staged_snapshot

  devbox_declared_stage="$(mktemp -d "${TMPDIR:-/tmp}/devbox-declared.XXXXXX")" ||
    die 'could not stage devbox desired inputs'
  chmod 0700 "$devbox_declared_stage" || die 'could not secure devbox desired inputs'
  cp -Rp "$base_dir/ansible" "$devbox_declared_stage/ansible" ||
    die 'could not stage devbox Ansible inputs'
  cp -Rp "$base_dir/assets" "$devbox_declared_stage/assets" ||
    die 'could not stage devbox assets'
  cp -Rp "$base_dir/lib" "$devbox_declared_stage/lib" ||
    die 'could not stage devbox libraries'
  cp -p "$base_dir/ansible.cfg" "$base_dir/cloud-init-devbox.template.yaml" \
    "$devbox_declared_stage/" || die 'could not stage devbox controller inputs'
  staged_snapshot="$(devbox_snapshot "$devbox_declared_stage")" ||
    die 'could not verify staged devbox desired inputs'
  [[ "$staged_snapshot" == "$devbox_desired_snapshot" ]] ||
    die 'staged devbox desired inputs differ from their validated source'
  ansible_config="$devbox_declared_stage/ansible.cfg"
  ansible_inventory="$devbox_declared_stage/ansible/inventory/devbox.yml"
  ansible_apply_playbook="$devbox_declared_stage/ansible/playbooks/apply.yml"
  template="$devbox_declared_stage/cloud-init-devbox.template.yaml"
}

devbox_validate_declared_inputs() {
  local path

  for path in "$ansible_inventory" "$ansible_apply_playbook" "$template"; do
    [[ -f "$path" && ! -L "$path" ]] || die "invalid devbox declared input: $path"
  done
  dotfiles_validate_declared_inputs
  ai_validate_inputs
  skidbladnir_validate_declared_inputs devbox
  for path in \
    __BOOTSTRAP_SSH_CIDR__:1 \
    __DEPLOY_PUBLIC_KEY__:1 \
    __DEPLOY_USER__:4 \
    __OPERATOR_PUBLIC_KEY__:1 \
    __SERVER_NAME__:2 \
    __SERVER_USER__:3 \
    __TAILSCALE_AUTH_KEY_B64__:1; do
    [[ "$(grep -Foc "${path%:*}" "$template")" == "${path##*:}" ]] ||
      die "cloud-init placeholder is not exact: ${path%:*}"
  done
  devbox_desired_snapshot="$(devbox_snapshot "$base_dir")" ||
    die 'could not resolve devbox desired inputs'
  devbox_stage_declared_inputs
  ANSIBLE_CONFIG="$ansible_config" ANSIBLE_NOCOLOR=1 \
    run_ansible_playbook --syntax-check \
    -i "$ansible_inventory" "$ansible_apply_playbook" >/dev/null ||
    die 'devbox Ansible declaration is invalid'
}

devbox_verify_desired_inputs() {
  local observed

  observed="$(devbox_snapshot "$devbox_declared_stage")" ||
    die 'could not verify devbox desired inputs'
  [[ "$observed" == "$devbox_desired_snapshot" ]] ||
    die 'devbox desired inputs changed during apply; rerun'
}

preflight() {
  local deploy_public_key operator_public_key status_json auth_key auth_key_framed existing_peer
  local peer_rc

  require_cmd gh hcloud python3 ssh ssh-keygen tailscale uvx
  [[ -d "$HOME" && ! -L "$HOME" && -d "$HOME/.ssh" && ! -L "$HOME/.ssh" ]] ||
    die 'operator SSH directory topology is invalid'
  if [[ -e "$ssh_known_hosts" || -L "$ssh_known_hosts" ]]; then
    [[ -f "$ssh_known_hosts" && ! -L "$ssh_known_hosts" ]] ||
      die "known-hosts target is not a regular file: $ssh_known_hosts"
  fi
  if [[ ! -e "$deploy_identity" && ! -L "$deploy_identity" ]]; then
    render_result ACTION 'deployment key' \
      "create $deploy_identity (mode 0600), then rerun ./devbox apply"
    finish_results devbox
  fi
  deploy_public_key="$(private_key_public "$deploy_identity")" ||
    die "deployment identity is not a valid private key: $deploy_identity"
  if [[ ! -e "$operator_identity" && ! -L "$operator_identity" ]]; then
    render_result ACTION 'operator key' \
      "create $operator_identity (mode 0600), then rerun ./devbox apply"
    finish_results devbox
  fi
  operator_public_key="$(private_key_public "$operator_identity")" ||
    die "operator identity is not a valid private key: $operator_identity"
  devbox_validate_declared_inputs

  observe_server || die 'could not resolve the exact Hetzner devbox server'
  observe_firewall || die 'could not resolve the exact Hetzner devbox firewall'
  steady_rules="$(steady_firewall_rules)"

  if [[ -n "$server_id" ]]; then
    [[ "$server_status" == running ]] ||
      die "Hetzner devbox is not running: $server_status"
    if [[ -n "$firewall_id" ]] &&
      ! firewall_applies_only_to "$server_id" true; then
      die 'the devbox firewall is attached to an unexpected resource'
    fi
    return 0
  fi

  status_json="$(tailscale status --json)" ||
    die 'could not inspect the local tailnet'
  require_cmd awk base64 cat curl tr
  [[ -f "$template" && ! -L "$template" ]] ||
    die "missing cloud-init template: $template"
  set +e
  existing_peer="$(tailnet_peer "$status_json" 2>/dev/null)"
  peer_rc=$?
  set -e
  if ((peer_rc == 0)); then
    die "tailnet node exists without its Hetzner server: $existing_peer"
  fi
  ((peer_rc == 3)) || die 'local Tailscale state is invalid'
  hcloud_cmd server-type describe "$server_type" >/dev/null
  hcloud_cmd location describe "$server_location" >/dev/null
  hcloud_cmd image describe --architecture "$server_image_architecture" \
    "$server_image" >/dev/null
  if [[ -n "$firewall_id" ]] && ! firewall_applies_only_to ''; then
    die 'the reusable devbox firewall is attached to an unexpected resource'
  fi
  if [[ ! -e "$tailscale_auth_key_file" && ! -L "$tailscale_auth_key_file" ]]; then
    render_result ACTION 'Tailscale enrollment' \
      "save a short-lived auth key to $tailscale_auth_key_file (mode 0600)"
    finish_results devbox
  fi
  [[ -f "$tailscale_auth_key_file" && ! -L "$tailscale_auth_key_file" ]] ||
    die "Tailscale auth key is not a regular file: $tailscale_auth_key_file"
  [[ "$(file_mode "$tailscale_auth_key_file")" == 600 ]] ||
    die "Tailscale auth key must have mode 0600: $tailscale_auth_key_file"
  auth_key="$(cat "$tailscale_auth_key_file")" ||
    die 'could not read the Tailscale auth key'
  auth_key_framed="$(cat "$tailscale_auth_key_file" && printf .)" ||
    die 'could not frame the Tailscale auth key'
  [[ "$auth_key_framed" == "$auth_key"$'\n.' ]] ||
    die 'Tailscale auth key must contain exactly one newline-terminated value'
  [[ ${#auth_key} -le 4096 &&
    "$auth_key" =~ ^tskey-auth-[A-Za-z0-9_-]+$ ]] ||
    die 'Tailscale auth key has an invalid shape'
  server_public_ip="$(curl -fsS4 https://api.ipify.org)"
  validate_ipv4 "$server_public_ip" ||
    die "operator public address is not IPv4: $server_public_ip"
  bootstrap_cidr="$server_public_ip/32"
  server_public_ip=''
  bootstrap_rules="$(bootstrap_firewall_rules "$bootstrap_cidr")"
  render_cloud_init "$operator_public_key" "$deploy_public_key" "$auth_key"
}

reconcile_existing_firewall_boundary() {
  ensure_firewall
  set_firewall_rules "$steady_rules" steady ||
    die 'could not install the steady Hetzner firewall rules'
  if ! firewall_applies_only_to "$server_id"; then
    hcloud_cmd firewall apply-to-resource \
      --type server --server "$server_name" "$firewall_name" >/dev/null
    render_result CHANGED 'Hetzner firewall' "attached to $server_name"
  fi
}

ensure_firewall() {
  if [[ -z "$firewall_id" ]]; then
    hcloud_cmd firewall create \
      --name "$firewall_name" \
      --label purpose=devbox \
      --label role=devbox >/dev/null
    render_result INSTALLED 'Hetzner firewall' "$firewall_name"
    observe_firewall || die 'new devbox firewall was not observable'
  fi
}

apply_existing_server() {
  local ssh_error

  if ! ssh_error="$(ssh_remote "$tailnet_host" yes true 2>&1)"; then
    case "$ssh_error" in
    *'Host key verification failed'* | *'Permission denied'*)
      render_result ACTION 'devbox cutover' \
        'install the deployment principal and verify its host key, then rerun ./devbox apply'
      finish_results devbox
      ;;
    *) die "tailnet deployment SSH failed: ${ssh_error:-unknown error}" ;;
    esac
  fi
  assert_remote_tailscale_ssh_disabled "$tailnet_host"
  if ! ssh_operator_remote "$tailnet_host" yes true >/dev/null 2>&1; then
    render_result ACTION 'devbox operator SSH' \
      'install the niels operator key and verify its OpenSSH host key, then rerun ./devbox apply'
    finish_results devbox
  fi

  install_ssh_config
}

apply_new_server() {
  ensure_firewall
  bootstrap_cleanup_required=1
  set_firewall_rules "$bootstrap_rules" bootstrap ||
    die 'could not install bootstrap firewall rules'

  hcloud_cmd server create \
    --name "$server_name" \
    --type "$server_type" \
    --image "$server_image" \
    --location "$server_location" \
    --firewall "$firewall_name" \
    --label purpose=devbox \
    --label environment=dev \
    --label role=devbox \
    --user-data-from-file "$rendered_cloud_init" >/dev/null
  render_result INSTALLED 'Hetzner server' "$server_name"

  observe_server || die 'new Hetzner devbox was not observable'
  [[ -n "$server_id" && "$server_status" == running ]] ||
    die 'new Hetzner devbox is not running'
  validate_ipv4 "$server_public_ip" ||
    die 'new Hetzner devbox has no valid public IPv4 address'
  prepare_new_host_key_candidate
  wait_for_public_ssh
  validate_new_host_key_candidate ||
    die 'public bootstrap SSH did not record exactly one valid devbox host key'
  ssh_remote "$server_public_ip" yes \
    sudo -n -- timeout 900 cloud-init status --wait ||
    die 'cloud-init did not complete successfully'

  wait_for_tailnet_host >/dev/null ||
    die 'new Hetzner devbox did not appear on the tailnet'
  ssh_remote "$tailnet_host" yes true >/dev/null ||
    die 'new devbox host key did not match over the tailnet'
  validate_new_host_key_candidate ||
    die 'verified devbox host key changed before trust-store promotion'
  commit_new_host_key
  cleanup_bootstrap || die 'bootstrap ingress cleanup failed'
  assert_remote_tailscale_ssh_disabled "$tailnet_host"
  ssh_operator_remote "$tailnet_host" yes true >/dev/null ||
    die 'new devbox operator SSH key was not accepted over the tailnet'
  install_ssh_config
}

run_ansible_apply() {
  local rc skid_action_code

  ansible_output="$(mktemp "${TMPDIR:-/tmp}/devbox-ansible.XXXXXX")"
  set +e
  ANSIBLE_CONFIG="$ansible_config" \
    ANSIBLE_NOCOLOR=1 \
    run_ansible_playbook \
    --ssh-common-args "-F $ssh_include" \
    -i "$ansible_inventory" "$ansible_apply_playbook" \
    >"$ansible_output" 2>&1
  rc=$?
  set -e
  if ((rc != 0)); then
    tail -c 65536 "$ansible_output" >&2 || true
    rm -f -- "$ansible_output"
    ansible_output=''
    render_result ERROR 'Ubuntu state' "Ansible apply failed with exit $rc"
    return 1
  fi

  if grep -Eq '^devbox[[:space:]]*:.*changed=[1-9][0-9]*' "$ansible_output"; then
    render_result CHANGED 'Ubuntu state' 'Ansible installed declared changes'
  fi
  if grep -Fq DEV_SERVER_DOCKER_DEFERRED "$ansible_output"; then
    render_result DEFERRED docker.config 'running containers keep current daemon inputs'
  fi
  if grep -Fq DEV_SERVER_TMUX_DEFERRED "$ansible_output"; then
    render_result DEFERRED tmux.config 'running sessions keep the prior tmux binary'
  fi
  if grep -Fq DEV_SERVER_REBOOT_DEFERRED "$ansible_output"; then
    render_result DEFERRED system.reboot 'reboot-required is present'
  fi
  skid_action_code="$(
    grep -Eo 'DEV_SERVER_SKID_ACTION_[A-Z_]+' "$ansible_output" |
      sort -u || true
  )"
  case "$skid_action_code" in
  '') ;;
  DEV_SERVER_SKID_ACTION_INSTALL_TAILSCALE)
    render_result ACTION tailscale.serve \
      'install and sign in to Tailscale, then rerun apply'
    ;;
  DEV_SERVER_SKID_ACTION_SIGN_IN_TAILSCALE)
    render_result ACTION tailscale.serve \
      'sign in to Tailscale, then rerun apply'
    ;;
  DEV_SERVER_SKID_ACTION_CLEAR_STALE_SERVE)
    render_result ACTION tailscale.serve \
      "remove the stale HTTPS 8443 mapping with 'tailscale serve --https=8443 off', then rerun apply"
    ;;
  *)
    rm -f -- "$ansible_output"
    ansible_output=''
    render_result ERROR 'Skíðblaðnir action' \
      'Ansible returned an invalid action code'
    return 1
    ;;
  esac
  rm -f -- "$ansible_output"
  ansible_output=''
}

check_github_enrollment() {
  local public_key account_keys key_status

  if ! gh auth status -h github.com >/dev/null 2>&1; then
    render_result ACTION 'GitHub enrollment' \
      'run: gh auth login -h github.com && ./devbox apply'
    return 0
  fi
  if ssh_remote "$tailnet_host" yes sudo -n -u "$server_user" -- \
    test -f "/home/$server_user/.ssh/id_ed25519_github.pub"; then
    key_status=0
  else
    key_status=$?
  fi
  if ((key_status == 1)); then
    render_result ACTION 'GitHub identity' \
      "run: ssh -F $ssh_include $server_name 'ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_github -N \"\" -C $server_user-dev-server-github', then rerun ./devbox apply"
    return 0
  fi
  ((key_status == 0)) || die 'could not inspect the devbox GitHub public key'
  public_key="$(ssh_remote "$tailnet_host" yes \
    sudo -n -u "$server_user" -- \
    cat "/home/$server_user/.ssh/id_ed25519_github.pub")" ||
    die 'could not read the devbox GitHub public key'
  public_key="$(awk '{print $1 " " $2}' <<<"$public_key")"
  account_keys="$(gh api user/keys --paginate --jq '.[].key')" ||
    die 'could not inspect GitHub SSH keys'
  if ! awk '{print $1 " " $2}' <<<"$account_keys" | grep -Fqx "$public_key"; then
    render_result ACTION 'GitHub enrollment' \
      "run: gh ssh-key add <(ssh -F $ssh_include $server_name 'cat ~/.ssh/id_ed25519_github.pub') --title $server_name"
  fi
}

cmd_apply() {
  (($# == 0)) || {
    usage >&2
    return 64
  }

  trap cleanup_on_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  preflight
  devbox_verify_desired_inputs

  if [[ -n "$server_id" ]]; then
    reconcile_existing_firewall_boundary
    tailnet_host="$(tailnet_peer "$(tailscale status --json)")" ||
      die 'the existing Hetzner devbox has no unique online tailnet node'
    apply_existing_server
  else
    apply_new_server
  fi
  devbox_verify_desired_inputs
  if ! run_ansible_apply; then
    finish_results devbox
  fi
  devbox_verify_desired_inputs
  check_github_enrollment
  firewall_rules_match "$steady_rules" ||
    die 'devbox public bootstrap ingress remains in the Hetzner firewall'
  firewall_applies_only_to "$server_id" ||
    die 'devbox firewall attachment differs after apply'
  finish_results devbox
}

main() {
  local command="${1:-}"

  case "$command" in
  apply)
    shift
    cmd_apply "$@"
    ;;
  help | --help | -h)
    (($# == 1)) || {
      usage >&2
      return 64
    }
    usage
    ;;
  '')
    usage
    return 64
    ;;
  *)
    usage >&2
    printf 'ERROR  unknown devbox operation: %s\n' "$command" >&2
    return 64
    ;;
  esac
}

main "$@"
